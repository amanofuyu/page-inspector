{
  "name": "@page-inspector/extension",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "Page Inspector",
  "engines": {
    "node": "^22.22.1"
  },
  "scripts": {
    "dev": "wxt --mode dev",
    "test": "vitest run",
    "build": "wxt build --mode prod",
    "zip:test": "wxt zip --mode dev",
    "zip": "wxt zip --mode prod",
    "postinstall": "wxt prepare",
    "typecheck": "vue-tsc --noEmit",
    "test:watch": "vitest",
    "build:dev": "wxt build --mode dev",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:nuxt": "playwright test -c playwright.nuxt.config.ts",
    "test:e2e:devtools": "playwright test -c playwright.devtools.config.ts"
  },
  "dependencies": {
    "@unhead/vue": "^3.4.1",
    "@webext-core/messaging": "^4.0.0",
    "devalue": "6.0.2"
  },
  "devDependencies": {
    "@lucide/vue": "^1.48.0",
    "@playwright/test": "1.63.0",
    "@shikijs/langs": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.0",
    "@vueuse/core": "^15.0.0",
    "@wxt-dev/module-vue": "^1.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "daisyui": "^5.7.46",
    "pinia": "^4.0.3",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.1",
    "vitest": "5.0.2",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11",
    "wxt": "^0.21.4"
  }
}
