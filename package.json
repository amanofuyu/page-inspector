{
  "name": "PageInspector",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "Page Inspector",
  "scripts": {
    "dev": "wxt --mode dev",
    "dev:firefox": "wxt -b firefox --mode dev",
    "test": "wxt build --mode dev",
    "test:firefox": "wxt build -b firefox --mode dev",
    "build": "wxt build --mode prod",
    "build:firefox": "wxt build -b firefox --mode prod",
    "zip:test": "wxt zip --mode dev",
    "zip:test:firefox": "wxt zip -b firefox --mode dev",
    "zip": "wxt zip --mode prod",
    "zip:firefox": "wxt zip -b firefox --mode prod",
    "open": "explorer.exe .",
    "compile": "vue-tsc --noEmit",
    "postinstall": "wxt prepare && npx simple-git-hooks",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "check": "taze major -r",
    "tup": "taze major -r -I"
  },
  "dependencies": {
    "@unhead/vue": "^2.1.2",
    "@webext-core/messaging": "^2.3.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.7.3",
    "@shikijs/langs": "^3.21.0",
    "@shikijs/themes": "^3.21.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "@types/chrome": "^0.1.33",
    "@vueuse/core": "^14.1.0",
    "@wxt-dev/module-vue": "^1.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "daisyui": "^5.5.14",
    "eslint": "^9.39.2",
    "eslint-plugin-format": "^1.2.0",
    "lint-staged": "^16.2.7",
    "lucide-vue-next": "^0.562.0",
    "pinia": "^3.0.4",
    "shiki": "^3.21.0",
    "simple-git-hooks": "^2.13.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "taze": "^19.9.2",
    "typescript": "^5.9.3",
    "unplugin-vue-components": "^30.0.0",
    "vite": "^7.3.1",
    "vue": "^3.5.26",
    "vue-tsc": "^3.2.2",
    "wxt": "^0.20.13"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint"
  }
}
