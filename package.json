{
  "name": "page-inspector",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.19.0",
  "description": "Page Inspector",
  "engines": {
    "node": "^22.22.1"
  },
  "scripts": {
    "dev": "pnpm --filter @page-inspector/extension dev",
    "icons:generate": "pnpm --filter @page-inspector/extension icons:generate",
    "dev:nuxt3": "pnpm --filter @page-inspector/nuxt3 dev",
    "dev:nuxt4": "pnpm --filter @page-inspector/nuxt4 dev",
    "build": "pnpm --filter @page-inspector/extension build",
    "build:dev": "pnpm --filter @page-inspector/extension build:dev",
    "build:all": "pnpm -r --workspace-concurrency=1 build",
    "fixtures:build": "node scripts/build-fixtures.mjs",
    "fixtures:typecheck": "pnpm --filter @page-inspector/nuxt3 --filter @page-inspector/nuxt4 typecheck",
    "zip": "pnpm --filter @page-inspector/extension zip",
    "zip:test": "pnpm --filter @page-inspector/extension zip:test",
    "test": "pnpm --filter @page-inspector/extension test",
    "test:watch": "pnpm --filter @page-inspector/extension test:watch",
    "test:e2e": "pnpm --filter @page-inspector/extension test:e2e",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "compile": "pnpm typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "taze major -r",
    "tup": "taze major -r -I",
    "prepare:hooks": "simple-git-hooks",
    "open": "explorer.exe .",
    "test:e2e:nuxt": "pnpm build && pnpm fixtures:build && pnpm --filter @page-inspector/extension test:e2e:nuxt",
    "test:e2e:all": "pnpm build && pnpm fixtures:build && pnpm --filter @page-inspector/extension exec playwright test && pnpm --filter @page-inspector/extension test:e2e:nuxt && pnpm --filter @page-inspector/extension test:e2e:devtools",
    "test:e2e:devtools": "pnpm build && pnpm --filter @page-inspector/extension test:e2e:devtools"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "eslint": "^10.11.0",
    "eslint-plugin-format": "^2.0.1",
    "lint-staged": "^17.6.0",
    "simple-git-hooks": "^2.14.0",
    "taze": "^21.2.0",
    "typescript": "6.0.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint"
  }
}
